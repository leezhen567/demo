    {
      "id": "repository_tools",
      "title": "读代码、执行现有工具或生成脚本",
      "keywords": [
        "源码",
        "代码",
        "文件",
        "目录",
        "模块",
        "Python",
        "脚本",
        "工具",
        "CSV",
        "统计"
      ],
      "steps": [
        "按功能索引查看真实模块和函数，必要时读取代码与说明",
        "复用已注册业务工具，或在隔离目录执行已有 Python 文件/新脚本",
        "核查退出码、输出内容和真实产物"
      ],
      "tools": [
        "read_agent_entry",
        "repository_tree",
        "read_repository_file",
        "run_repository_tool",
        "run_python"
      ],
      "code": [
        {
          "path": "automotive_tara/assistant_repository.py",
